# Backend/Intelligence Python base (rare rebuild)
FROM python:3.12-slim AS backend-base

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /workspace

COPY requirements.txt /workspace/requirements.txt
RUN pip install --no-cache-dir -r /workspace/requirements.txt


# Backend app image (frequent rebuild, small delta)
FROM backend-base AS backend-image

WORKDIR /workspace
COPY backend-python /workspace/backend-python

EXPOSE 3001
CMD ["gunicorn", "--chdir", "/workspace/backend-python", "--bind", "0.0.0.0:3001", "--workers", "4", "--threads", "4", "--timeout", "120", "app:app"]


# Intelligence app image (frequent rebuild, small delta)
FROM backend-base AS intelligence-image

WORKDIR /workspace
COPY intelligence_layer /workspace/intelligence_layer
COPY backend-python /workspace/backend-python

EXPOSE 5010
CMD ["python", "intelligence_layer/app.py"]


# Frontend dependency base (rare rebuild)
FROM node:22-alpine AS frontend-base

WORKDIR /workspace/frontend

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci


# Frontend builder (frequent rebuild, source only)
FROM frontend-base AS frontend-builder

WORKDIR /workspace/frontend
COPY frontend/ ./
# Vite reads VITE_* vars from envDir (repo root) at build time.
# Copy the root .env so feature flags are baked into the bundle.
COPY .env /workspace/.env
RUN npm run build


# Frontend runtime image
FROM nginx:alpine AS frontend-image

COPY --from=frontend-builder /workspace/frontend/dist /usr/share/nginx/html
# nginx:alpine auto-runs executable scripts in /docker-entrypoint.d/ before starting.
# sed strips any CRLF so the script works even if edited/committed on Windows.
COPY docker/frontend-entrypoint.sh /docker-entrypoint.d/40-talentsync-config.sh
RUN sed -i 's/\r$//' /docker-entrypoint.d/40-talentsync-config.sh \
    && chmod +x /docker-entrypoint.d/40-talentsync-config.sh

RUN printf 'server {\n\
    listen 80;\n\
    client_max_body_size 50M;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
\n\
    location /api/ {\n\
        proxy_pass http://backend:3001;\n\
    proxy_http_version 1.1;\n\
        proxy_set_header Host $host;\n\
        proxy_set_header X-Real-IP $remote_addr;\n\
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
    proxy_set_header X-Forwarded-Proto $scheme;\n\
    proxy_connect_timeout 30s;\n\
    proxy_send_timeout 120s;\n\
    proxy_read_timeout 120s;\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80
