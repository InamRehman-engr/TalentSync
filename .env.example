# Database
DATABASE_URL=postgresql://nhr:nhr_secret@localhost:5432/nhr

# Intelligence layer
INTELLIGENCE_URL=http://localhost:5010
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=resumes
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
OLLAMA_MODEL=qwen2.5:7b
RESUME_SIMILARITY_THRESHOLD=0.95

# GitHub candidate search (server-side only — never expose to frontend)
GITHUB_PAT=PAT_TOKEN 

# Frontend feature flags (read at container startup for Docker; build-time fallback for local dev)
VITE_SHOW_EMPLOYEE_DASHBOARD=true
VITE_SHOW_QUICK_DEMO=true
VITE_SHOW_PRICING_CONTACT_OVERLAY=true
VITE_PRICING_CONTACT_EMAIL=hello@talentsync.com
